# Firebase Configuration
# Copia este archivo como .env y reemplaza los valores con los de tu proyecto Firebase
# Consola: https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=tu-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Gemini (solo servidor; configurar en Vercel > Settings > Environment Variables, SIN prefijo VITE_)
# GEMINI_API_KEY=tu_clave_de_https://aistudio.google.com/apikey
# Solo para el APK de Android: URL de tu despliegue en Vercel
# VITE_API_BASE_URL=https://tu-proyecto.vercel.app
